AUTH_SECRET=              # generate with: npx auth secret

AUTH_SCALEKIT_ISSUER=     # e.g. https://yourenv.scalekit.dev
AUTH_SCALEKIT_ID=         # Client ID from Scalekit dashboard (skc_...)
AUTH_SCALEKIT_SECRET=     # Client secret from Scalekit dashboard
AUTH_SCALEKIT_CONNECTION_ID=   # Optional: route to a specific SSO connection (conn_...)

